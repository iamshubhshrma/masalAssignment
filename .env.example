# ─── AI (required) ────────────────────────────────────────────────────────────
# Both are free-tier. Set at least one; set both and the app falls back
# automatically when one rate-limits (Groq free tier is 8k tokens/min).
GROQ_API_KEY=
GOOGLE_API_KEY=

GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash

# auto = try Groq then Gemini. Naming one makes it the primary, not the only one.
LLM_ENGINE=auto

# ─── Voice follow-up (optional bonus feature) ─────────────────────────────────
# true  = simulated calls, no keys or credits needed (safe for a public demo)
# false = real outbound calls via Ringg AI
MOCK_MODE=true

RINGG_API_KEY=
RINGG_AGENT_ID=
# Set exactly ONE of these; Ringg rejects both together.
RINGG_FROM_NUMBER_ID=
RINGG_FROM_NUMBER=
